<svg height="100" width="100" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
<mask
  id="stroke-cutout-letter-l"
  maskUnits="userSpaceOnUse"
  x="0"
  y="0"
  width="100"
  height="100"
>
  <rect x="0" y="0" width="100" height="100" fill="white" />
  <rect x="0" y="0" width="100" height="85" fill="black" />
</mask>
  <line x1="50" y1="0" x2="50" y2="85" stroke="black" stroke-width="10" />
<circle cx="60" cy="85" r="10"
          fill="none"
          stroke="black"
          stroke-width="10" mask="url(#stroke-cutout-letter-l)" />
