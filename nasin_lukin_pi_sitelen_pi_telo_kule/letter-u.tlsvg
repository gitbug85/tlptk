<svg height="100" width="100" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
<mask
  id="stroke-cutout-letter-u"
  maskUnits="userSpaceOnUse"
  x="0"
  y="0"
  width="100"
  height="100"
>
  <rect x="0" y="0" width="100" height="100" fill="white" />
  <rect x="0" y="0" width="100" height="50" fill="black" />
</mask>
<line x1="95" y1="0" x2="95" y2="100" stroke="black" stroke-width="10" />
<line x1="5" y1="0" x2="5" y2="50" stroke="black" stroke-width="10" />
  <circle cx="50" cy="50" r="45"
          fill="none"
          stroke="black"
          stroke-width="10" mask="url(#stroke-cutout-letter-u)"/>
